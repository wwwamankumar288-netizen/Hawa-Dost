# ─── Required API Keys ─────────────────────────────────────────────────────────

# Google Gemini API (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# World Air Quality Index API (get free token from https://aqicn.org/api/)
WAQI_API_TOKEN=your_waqi_token_here

# OpenWeatherMap API (free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_key_here

# ─── Optional ──────────────────────────────────────────────────────────────────

# Google Maps API (for geocoding, optional)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database (optional — for persistent user profiles)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hawa_dost

# Redis (optional — for AQI caching)
# REDIS_URL=redis://localhost:6379/0

